{
  "name": "postlens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "jev:smoke": "node --env-file-if-exists=.env --import tsx scripts/jev-smoke.ts",
    "jev:experiment": "node --env-file-if-exists=.env --import tsx scripts/jev-experiment.ts",
    "jev:batching": "node --env-file-if-exists=.env --import tsx scripts/jev-batching-experiment.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
