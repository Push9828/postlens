TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=10000

# Targeted Improvement uses the OpenAI Responses API. Leave the key empty to
# return a controlled 503 from /api/improvements.
OPENAI_API_KEY=
OPENAI_IMPROVEMENT_MODEL=gpt-4o-mini
OPENAI_IMPROVEMENT_TIMEOUT_MS=20000

# Experiments disable retries so raw failure rates remain visible.
JEV_REPEAT_COUNT=5
