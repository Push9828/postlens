TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=10000

# Targeted Improvement uses the OpenAI Responses API. Leave the key empty to
# return a controlled 503 from /api/improvements.
OPENAI_API_KEY=
OPENAI_IMPROVEMENT_MODEL=gpt-4o-mini
OPENAI_IMPROVEMENT_TIMEOUT_MS=20000

# Vercel production request guard. Use a writable Upstash Redis REST token.
# Production provider calls fail closed when these are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters; keep this server-side and stable across deploys.
RATE_LIMIT_HASH_SECRET=

# Phase 8 benchmark uses independently pinned evaluator models. Live modes
# require both keys, documented token prices, and explicit attempt/spend caps.
BENCHMARK_JEV_MODEL=jev-1.13.0
BENCHMARK_LLM_MODEL=gpt-4o-mini-2024-07-18
BENCHMARK_MAX_ATTEMPTS=
BENCHMARK_MAX_USD=
# Set true only after setting a hard spend cap with each provider. The local
# token estimate is advisory because Jev output tokens cannot be capped here.
BENCHMARK_PROVIDER_SPEND_CAP_CONFIRMED=
BENCHMARK_PRICE_DATE=
BENCHMARK_JEV_PRICE_SOURCE=
BENCHMARK_LLM_PRICE_SOURCE=
BENCHMARK_JEV_INPUT_USD_PER_MILLION=
BENCHMARK_JEV_OUTPUT_USD_PER_MILLION=
BENCHMARK_LLM_INPUT_USD_PER_MILLION=
BENCHMARK_LLM_OUTPUT_USD_PER_MILLION=

# Experiments disable retries so raw failure rates remain visible.
JEV_REPEAT_COUNT=5
